{
  "name": "promptatelier-nano",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Prompt Atelier without a server: one HTML file, storage in the browser.",
  "license": "MIT",
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "sync:check": "node scripts/sync.mjs --check",
    "audit": "node scripts/audit.mjs",
    "prebuild": "node scripts/sync.mjs --quiet && node scripts/audit.mjs",
    "build": "vite build",
    "dev": "vite",
    "pretest": "node scripts/sync.mjs --quiet",
    "test": "node --test tests/",
    "build:tests": "vite build --config vite.tests.config.js",
    "test:browser": "npm run build:tests && node scripts/run-browser-tests.mjs",
    "test:all": "npm test && npm run test:browser",
    "screens": "npm run build && node scripts/screens.mjs dist/index.html",
    "accept": "node scripts/accept.mjs dist/index.html",
    "accept:all": "node scripts/accept.mjs dist/index.html --all",
    "release": "node scripts/release.mjs",
    "check": "npm run sync:check && npm run audit && npm test && npm run build && npm run build:tests && node scripts/run-browser-tests.mjs --all && node scripts/accept.mjs dist/index.html --all && node scripts/screens.mjs dist/index.html",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "formic"
}
